# ============================================================================
# ComfyUI Serverless — IMAGE Generation (Pony + FaceDetailer + Upscale)
# ============================================================================
# Base: runpod/worker-comfyui (has serverless handler built-in)
# Workflows: pony_v6_real.json, upscale_real.json
#
# Uses the proven install_models.sh script that was tested on rented pods.
# ============================================================================

FROM runpod/worker-comfyui:5.8.5-base

# Build args for gated model downloads (passed as env vars to the script)
ARG CIVITAI_TOKEN=""
ARG HF_TOKEN=""
ENV CIVITAI_TOKEN=${CIVITAI_TOKEN}
ENV HF_TOKEN=${HF_TOKEN}

# ============================================================================
# PATH COMPATIBILITY
# ============================================================================
# The worker-comfyui base image installs ComfyUI at /comfyui (lowercase).
# Our proven install scripts detect /ComfyUI (uppercase).
# A symlink bridges the gap without modifying the scripts.
# ============================================================================
RUN ln -s /comfyui /ComfyUI

# ============================================================================
# COPY & RUN THE PROVEN INSTALL SCRIPT
# ============================================================================
COPY install_models.sh /tmp/install_models.sh
RUN chmod +x /tmp/install_models.sh && /tmp/install_models.sh && rm /tmp/install_models.sh

# ============================================================================
# CLEANUP — Don't leak tokens into the final image layers
# ============================================================================
ENV CIVITAI_TOKEN=""
ENV HF_TOKEN=""

# ============================================================================
# NOTE: No custom handler needed — worker-comfyui base image includes one.
# The built-in handler accepts {"input": {"workflow": {...}}} and returns
# images as base64. See README.md for output format details.
# ============================================================================

WORKDIR /comfyui
