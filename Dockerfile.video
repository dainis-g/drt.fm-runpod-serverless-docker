# ============================================================================
# ComfyUI Serverless — VIDEO Generation (Wan 2.2 I2V + T2V)
# ============================================================================
# Base: runpod/worker-comfyui (has serverless handler built-in)
# Workflows: animate_real.json, animate_t2v_real.json
#
# Uses the proven install_models_fast.sh script that was tested on rented pods.
# ============================================================================

FROM runpod/worker-comfyui:5.8.5-base

# Build args for gated model downloads (passed as env vars to the script)
ARG HF_TOKEN=""
ARG CIVITAI_TOKEN=""

# ============================================================================
# SYSTEM DEPENDENCIES
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# PATH COMPATIBILITY
# ============================================================================
# The worker-comfyui base image installs ComfyUI at /comfyui (lowercase).
# Our proven install scripts detect /ComfyUI (uppercase).
# A symlink bridges the gap without modifying the scripts.
# ============================================================================
RUN ln -s /comfyui /ComfyUI

# ============================================================================
# COPY & RUN THE PROVEN INSTALL SCRIPT
# ============================================================================
COPY install_models_fast.sh /tmp/install_models_fast.sh
RUN chmod +x /tmp/install_models_fast.sh \
    && HF_TOKEN="${HF_TOKEN}" CIVITAI_TOKEN="${CIVITAI_TOKEN}" /tmp/install_models_fast.sh \
    && rm /tmp/install_models_fast.sh



# ============================================================================
# PATCH: Add video output support to the built-in handler.
# The default handler only returns SaveImage outputs ("images" key).
# VHS_VideoCombine outputs under "gifs" key — this patch adds handling
# so video files are returned in the API response as "videos".
# ============================================================================
COPY patch_handler_video.py /tmp/patch_handler_video.py
RUN python /tmp/patch_handler_video.py && rm /tmp/patch_handler_video.py

WORKDIR /comfyui
